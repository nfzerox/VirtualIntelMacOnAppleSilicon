#!/bin/zsh
set -euo pipefail
root=${0:A:h:h}
mkdir -p "$root/Build/Probes"
xcrun clang -fobjc-arc -fmodules -Wall -Wextra -mmacosx-version-min=11.0 -arch x86_64 -arch arm64 \
    -I "$root/VirtualIntelMac" -framework Cocoa -framework Metal -framework QuartzCore \
    "$root/probes/app-scroll-input.m" "$root/VirtualIntelMac/VIMMetalView.m" \
    -o "$root/Build/Probes/app-scroll-input"
exec "$root/Build/Probes/app-scroll-input"
