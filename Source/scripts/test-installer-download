#!/bin/zsh
set -euo pipefail
root=${0:A:h:h}
scratch=$(mktemp -d /tmp/vim-download-test.XXXXXX)
mkdir -p "$scratch/mirror/content/downloads/vim-test"
mkfile 8m "$scratch/mirror/content/downloads/vim-test/Payload.pkg"
ln "$scratch/mirror/content/downloads/vim-test/Payload.pkg" "$scratch/mirror/content/downloads/vim-test/Update.tar"
python3 "$root/scripts/installer-mock-server.py" --root "$scratch/mirror" --port 0 \
    --bytes-per-second 2097152 --ready-file "$scratch/port" > "$scratch/server.log" 2>&1 &
server_pid=$!
stream_pid=
trap 'kill "$server_pid" ${stream_pid:+"$stream_pid"} 2>/dev/null || true' EXIT
for attempt in {1..50}; do
    [[ -s "$scratch/port" ]] && break
    sleep 0.1
done
[[ -s "$scratch/port" ]] || { print -u2 "Mirror failed: $scratch/server.log"; exit 1; }
port=$(cat "$scratch/port")
xcrun clang -fobjc-arc -fmodules -Wall -mmacosx-version-min=11.0 \
    -I "$root/VirtualIntelMac" -framework AppKit -framework Security \
    "$root/probes/installer-download-tests.m" "$root/VirtualIntelMac/VIMDownload.m" \
    "$root/VirtualIntelMac/VIMInstallerCatalog.m" "$root/VirtualIntelMac/VIMInstallerSource.m" \
    -o "$scratch/installer-download-tests"
"$scratch/installer-download-tests" "http://127.0.0.1:$port" "$scratch/transfer"
"$scratch/installer-download-tests" "http://127.0.0.1:$port" "$scratch/update-transfer" \
    "https://swcdn.apple.com/content/downloads/vim-test/Update.tar"
python3 "$root/scripts/installer-mock-server.py" --root "$scratch/mirror" --port 0 \
    --omit-content-length --bytes-per-second 2097152 --ready-file "$scratch/stream-port" > "$scratch/stream-server.log" 2>&1 &
stream_pid=$!
for attempt in {1..50}; do
    [[ -s "$scratch/stream-port" ]] && break
    sleep 0.1
done
[[ -s "$scratch/stream-port" ]] || { print -u2 "Streaming mirror failed: $scratch/stream-server.log"; exit 1; }
stream_port=$(cat "$scratch/stream-port")
"$scratch/installer-download-tests" "http://127.0.0.1:$stream_port" "$scratch/stream-transfer" \
    "https://swcdn.apple.com/content/downloads/vim-test/Payload.pkg" --unknown-length
print "Evidence retained in $scratch"
