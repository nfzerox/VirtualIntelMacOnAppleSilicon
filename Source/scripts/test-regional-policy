#!/bin/zsh
set -euo pipefail
source_root=${0:A:h:h}
test_dir=$(mktemp -d /tmp/vim-regional-policy.XXXXXX)
trap 'rm -rf "$test_dir"' EXIT
for ownership in -fno-objc-arc -fobjc-arc; do
xcrun clang "$ownership" -Wall -Wextra -Werror -Wno-unused-parameter \
    -I "$source_root/tools" "$source_root/probes/regional-policy-tests.m" \
    "$source_root/tools/guest-regional-policy.m" -framework Foundation -o "$test_dir/test"
"$test_dir/test"
done
xcrun clang -fno-objc-arc -Wall -Wextra -Werror -Wunguarded-availability \
    -mmacosx-version-min=10.4 -c "$source_root/tools/guest-regional-policy.m" \
    -o "$test_dir/policy-period-availability.o"
