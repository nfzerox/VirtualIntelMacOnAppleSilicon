#!/bin/zsh
set -euo pipefail
root=${0:A:h:h}
mkdir -p "$root/Build/Probes"
xcrun clang -fobjc-arc -fmodules -Wall -arch arm64 -arch x86_64 -mmacosx-version-min=11.0 \
    -I "$root/VirtualIntelMac" -framework AppKit -framework IOKit \
    "$root/probes/host-support-tests.m" "$root/VirtualIntelMac/VIMHostSupport.m" \
    "$root/VirtualIntelMac/VIMAlerts.m" \
    -o "$root/Build/Probes/host-support-tests"
exec "$root/Build/Probes/host-support-tests"
