#!/bin/bash
# Optional conformance tools only; nothing here is linked into the app.
# Compile the same public-GL tests for both Intel guest widths with period
# headers/libraries. Separate CMake builds avoid mixed pointer-size probes.
set -euo pipefail
[[ $# -ge 2 ]] || { echo "Usage: $0 PIGLIT_SOURCE NEW_OUTPUT_DIRECTORY [TARGET ...]" >&2;exit 64; }
root="$(cd "$(dirname "$0")/.." && pwd)"
source_dir="$(cd "$1" && pwd)"
output="$2"
shift 2
[[ ! -e "$output" ]] || { echo 'Choose a new output directory.' >&2;exit 65; }
sdk="${VIM_OPENGL_SDK:-$root/resources/sdk/MacOSX10.9.sdk}"
toolchain="${VIM_OPENGL_TOOLCHAIN:-$root/resources/xcode/XcodeMojave.app/Contents/Developer/Toolchains/XcodeDefault.xctoolchain/usr/bin}"
python="${VIM_PIGLIT_PYTHON:-$(command -v python3)}"
"$python" -c 'import mako,numpy' || { echo 'Set VIM_PIGLIT_PYTHON to a Python environment with Mako and NumPy.' >&2;exit 66; }
targets=("$@")
if [[ ${#targets[@]} == 0 ]]; then
    targets=(draw-pixels copy-pixels dlist-color-material texgen fog-modes
        two-sided-lighting polygon-mode linestipple pbo-drawpixels
        pbo-getteximage pbo-teximage drawpix-z stencil-drawpixels)
fi
mkdir -p "$output"
output="$(cd "$output" && pwd)"
git -C "$source_dir" rev-parse HEAD >"$output/source-revision.txt"
for arch in x86_64 i386; do
    build="$output/$arch"
    cmake -S "$source_dir" -B "$build" -G Ninja -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCMAKE_BUILD_TYPE=Release "-DCMAKE_C_COMPILER=$toolchain/clang" \
        "-DCMAKE_CXX_COMPILER=$toolchain/clang++" -DCMAKE_CXX_FLAGS=-stdlib=libc++ \
        "-DCMAKE_AR=$(xcrun --find ar)" "-DCMAKE_RANLIB=$(xcrun --find ranlib)" \
        "-DCMAKE_OSX_ARCHITECTURES=$arch" -DCMAKE_OSX_DEPLOYMENT_TARGET=10.7 \
        "-DCMAKE_OSX_SYSROOT=$sdk" "-DPYTHON_EXECUTABLE=$python" \
        '-DCMAKE_BUILD_RPATH=@loader_path/../lib' \
        -DPIGLIT_USE_WAFFLE=OFF -DPIGLIT_BUILD_CL_TESTS=OFF -DPIGLIT_BUILD_VK_TESTS=OFF \
        -DPIGLIT_BUILD_GLX_TESTS=OFF -DPIGLIT_BUILD_EGL_TESTS=OFF \
        -DCMAKE_DISABLE_FIND_PACKAGE_PNG=TRUE >"$output/$arch-configure.log" 2>&1
    cmake --build "$build" --target "${targets[@]}" -j4 >"$output/$arch-build.log" 2>&1
    echo "Built $arch: ${targets[*]}"
done
