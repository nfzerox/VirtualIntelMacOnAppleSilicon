#!/bin/zsh
set -euo pipefail
root=${0:A:h:h}
out=${1:?usage: build-guest-prepare NEW_OUTPUT}
[[ ! -e $out ]] || { print -u2 'Output exists; choose a new staging path.'; exit 73; }
xcrun clang -arch x86_64 -mmacosx-version-min=10.14 -fobjc-arc -O2 -Wall -Wextra -I "$root/vendor/xz-api" \
    -framework Foundation -framework Security -lz -llzma.5 "$root/tools/guest-prepare.m" -o "$out"
codesign --force --sign - "$out"
