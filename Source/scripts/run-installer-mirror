#!/bin/zsh
# Reuse already-downloaded files; this server never fetches from Apple.
set -euo pipefail
root=${0:A:h:h}
mirror=${VIM_INSTALLER_MIRROR:?Set VIM_INSTALLER_MIRROR to the folder of already-downloaded installer files}
mkdir -p "$mirror"
print 'Enable VIMDebugMode and set VIMDownloadServer to http://127.0.0.1:8765.'
print 'Mirror files must retain their original /content/downloads/... paths.'
exec python3 "$root/scripts/installer-mock-server.py" --root "$mirror" --port 8765
