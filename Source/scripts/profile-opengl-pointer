#!/usr/bin/env python3
"""Pace real guest pointer input through the visible app's production owner.

Prepare a real Finder window first; Origin is on its draggable title bar, in
QEMU's normalized 0..32767 coordinates. MarkerRect is a backing-pixel rectangle
containing only its red close button throughout the motion. No SSH/AX queries
or guest-side polling occur while moving. Leave real user input alone.
"""
import argparse
import bisect
import collections
import json
import math
import os
from pathlib import Path
import time

p = argparse.ArgumentParser(description=__doc__)
p.add_argument('directory', nargs='?', type=Path, help='per-VM app diagnostics directory')
p.add_argument('--origin', type=float, nargs=2)
p.add_argument('--amplitude', type=float, nargs=2)
p.add_argument('--marker-rect', type=float, nargs=4)
p.add_argument('--pattern', choices=['circle', 'reversals', 'steps'], default='circle')
p.add_argument('--seconds', type=float, default=8)
p.add_argument('--hz', type=float, default=120)
p.add_argument('--output', type=Path)
p.add_argument('--command-drag', action='store_true', help='Hold guest Command only during the drag, preserving inactive-window focus')
p.add_argument('--analyze', type=Path, help='Analyze an existing raw result without touching the app/VM')
args = p.parse_args()
if args.analyze:
    data = json.loads(args.analyze.read_text())
    args.pattern, args.seconds = data['Pattern'], data['Seconds']
else:
    if not args.directory or not args.output or not args.origin or not args.amplitude or not args.marker_rect:
        p.error('A live run needs directory, output, origin, amplitude and marker rectangle.')
    values = args.origin+args.amplitude+args.marker_rect+[args.seconds, args.hz]
    if not all(math.isfinite(v) for v in values) or not 1 <= args.seconds <= 15 or not 15 <= args.hz <= 120:
        p.error('Choose finite coordinates, Seconds 1–15 and Hz 15–120.')
    if not args.directory.is_dir() or args.output.exists():
        p.error('Use an existing diagnostic directory and a new output file.')
    request, running, result = (args.directory/n for n in ['Request.json', 'Running.json', 'Result.json'])
    if request.exists() or running.exists():
        raise SystemExit('Another app diagnostic is pending; do not start another control client.')
    old = result.stat().st_mtime_ns if result.exists() else None
    command = dict(Action='pointer-workload', Pattern=args.pattern, Seconds=args.seconds,
                   Hz=args.hz, Origin=args.origin, Amplitude=args.amplitude, MarkerRect=args.marker_rect,
                   CommandDrag=args.command_drag)
    with os.fdopen(os.open(request, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600), 'w') as stream:
        json.dump(command, stream)
    deadline = time.monotonic()+args.seconds+15
    while time.monotonic() < deadline:
        if result.exists() and result.stat().st_mtime_ns != old and not request.exists() and not running.exists():
            data = json.loads(result.read_text())
            break
        time.sleep(.1)
    else:
        raise SystemExit('No finite workload result; check the app. Do not retry over a second QMP socket.')
    args.output.write_text(json.dumps(data, indent=2)+'\n')
if 'Error' in data:
    raise SystemExit(data['Error'])


def summary(values):
    values = sorted(values)
    if not values:
        return dict(Samples=0)
    return dict(Samples=len(values), Mean=sum(values)/len(values),
                P50=values[math.ceil(len(values)*.50)-1], P95=values[math.ceil(len(values)*.95)-1],
                Max=values[-1])


before, after = data['Before'], data['After']
a, b = before['DistinctPresentationTiming'], after['DistinctPresentationTiming']
trace = b['Trace']
valid = (bool(trace) and a['Generation'] == b['Generation'] and not b['TraceDropped'] and
         b['Failures'] == a['Failures'] and b['Reordered'] == a['Reordered'] and not b['Error'])
motion = [row for row in trace if data['MotionStart'] <= row[0] < data['MotionEnd']]
changed = [row for row in motion if row[2]]
gaps = [(r[0]-l[0])*1000 for l, r in zip(changed, changed[1:])]
inputs = data['Inputs']
report = dict(MeasurementValid=valid, Pattern=args.pattern, MotionSeconds=args.seconds,
              CommandDrag=data.get('CommandDrag', False),
              PresentedDuringMotion=len(motion), ChangedImagesDuringMotion=len(changed),
              ChangedImagesPerMotionSecond=len(changed)/args.seconds,
              ChangedImageGapsMilliseconds=summary(gaps),
              MissedHostTimerTicks=data['MissedHostTimerTicks'],
              MaximumHostTimerLatenessMilliseconds=data['MaximumHostTimerLatenessMilliseconds'],
              InputEvents=len(inputs),
              UnpresentedDrawables=b['Unpresented']-a['Unpresented'],
              Caution='Motion-only RGB fingerprint pacing, not a collision-free comparison or physical photon measurement. Steps intentionally hold still; do not interpret their changed-image rate as animation FPS.')
replies = data.get('InputReplies', [])
report['ControlReplies'] = len(replies)
report['InputControlErrors'] = [row[2] for row in replies if row[2]]
report['InputControlMilliseconds'] = summary([(row[1]-row[0])*1000 for row in replies])
if len(replies) != len(inputs) or report['InputControlErrors']:
    report['MeasurementValid'] = valid = False
width, height = after['PixelWidth'], after['PixelHeight']
# Make slow and rapid trials distinguishable in the result itself. A 120-Hz
# input rate does not imply human-speed motion: circle makes two revolutions
# over Seconds, and amplitude is independently configurable. Use actual
# queued times, not timer deadlines, for delivered-path speeds. These are
# requested pointer velocities, NOT observed window velocities or latency.
path = [row for row in inputs if row[4] == 'motion']
view_width, view_height = after['ViewWidth'], after['ViewHeight']
distances, speeds = [], []
for left, right in zip(path, path[1:]):
    distance = math.hypot((right[2]-left[2])*view_width/32767,
                          (right[3]-left[3])*view_height/32767)
    elapsed = right[0]-left[0]
    if elapsed > 0:
        distances.append(distance)
        speeds.append(distance/elapsed)
report['QueuedPointerMotion'] = dict(
    DistanceLogicalPoints=sum(distances),
    SpeedLogicalPointsPerSecond=summary(speeds),
    Caution='Actual queued pointer path, not displayed window speed or input-to-visible latency.')
calibration = next(row for row in inputs if row[4] == 'calibration')
returned = next(row for row in inputs if row[4] == 'calibration-return')
origin = next(row for row in inputs if row[4] == 'origin')
settled = [tuple(row[3:5]) for row in trace
           if returned[0] <= row[0] < data['MotionStart'] and row[3] >= 0]
# A damage-driven page-flip display may present the returned position once,
# then remain idle. Do not discard that real presentation by requiring a
# second frame after an arbitrary 50-ms delay. The independent two-axis
# correspondence check below still rejects stale or unrelated red markers.
baseline = collections.Counter(settled).most_common(1)[0][0] if settled else None
calibrated = False
if baseline:
    expected = (baseline[0]+(calibration[2]-origin[2])*width/32767,
                baseline[1]+(calibration[3]-origin[3])*height/32767)
    calibrated = any(calibration[0] <= row[0] < returned[0] and
                     abs(row[3]-expected[0]) <= 3 and abs(row[4]-expected[1]) <= 3 for row in trace)
report['MarkerCalibrationValid'] = calibrated
report['MarkerOriginBackingPixels'] = baseline
report['PresentationTraceValid'] = valid
if args.pattern in ('circle', 'reversals'):
    # A static red background icon can win the marker reduction after another
    # window is raised. Valid RGB hashes alone do not qualify a window drag.
    # Require the marker to follow actual queued two-axis displacements, not
    # just change color or happen to span an unrelated animation. The bounded
    # 250-ms correspondence window is a measurement qualification limit, NOT
    # a guest timeout, assumed latency score or a reason to restart anything.
    samples = [row for row in motion if row[3] >= 0]
    path = [row for row in inputs if row[4] == 'motion']
    times = [row[0] for row in path]
    observed = [max(row[axis+3] for row in samples)-min(row[axis+3] for row in samples)
                if samples else 0 for axis in range(2)]
    requested = [(max(row[axis+2] for row in path)-min(row[axis+2] for row in path))*extent/32767
                 if path else 0 for axis, extent in enumerate((width, height))]
    matched = 0
    for row in samples:
        recent = path[bisect.bisect_left(times, row[0]-.25):bisect.bisect_right(times, row[0])]
        if baseline and any(abs(row[3]-(baseline[0]+(point[2]-origin[2])*width/32767)) <= 3 and
                            abs(row[4]-(baseline[1]+(point[3]-origin[3])*height/32767)) <= 3
                            for point in recent):
            matched += 1
    fraction = matched/len(samples) if samples else 0
    coherent = (bool(baseline) and len(samples) >= 5 and fraction >= .95 and
                any(span > 3 for span in requested) and
                all(span <= 3 or actual >= max(3, span*.5)
                    for actual, span in zip(observed, requested)))
    report['WindowMarkerMotion'] = dict(CoordinatesVerified=coherent,
        MatchingSamples=matched, Samples=len(samples), MatchingFraction=fraction,
        ObservedSpanBackingPixels=observed, RequestedSpanBackingPixels=requested,
        MaximumCorrespondenceMilliseconds=250, PositionToleranceBackingPixels=3)
    if not coherent:
        report['MeasurementValid'] = valid = False
if args.pattern == 'steps':
    steps = [row for row in inputs if row[4] == 'motion']
    latencies, missed, observations = [], [], []
    for index, step in enumerate(steps):
        # Step zero is deliberately the original position, not a latency edge.
        if not step[5]:
            continue
        end = steps[index+1][0] if index+1 < len(steps) else data['MotionEnd']
        expected = (baseline[0]+(step[2]-origin[2])*width/32767,
                    baseline[1]+(step[3]-origin[3])*height/32767) if baseline else None
        match = next((row for row in trace if expected and step[0] <= row[0] < end and
                      abs(row[3]-expected[0]) <= 3 and abs(row[4]-expected[1]) <= 3), None)
        if match:
            ms = (match[0]-step[0])*1000
            latencies.append(ms)
            observations.append(dict(Step=step[5], Milliseconds=ms, Marker=match[3:5], Expected=expected))
        else:
            missed.append(step[5])
    # A skipped initial pulse must stay explicit. Independent, correctly sized
    # displacements in both axes across >=3 held steps can also validate the
    # marker coordinates. Never manufacture a match for a missing step.
    motion_calibrated = (len(observations) >= 3 and
                         len({round(row['Expected'][0]) for row in observations}) >= 2 and
                         len({round(row['Expected'][1]) for row in observations}) >= 2)
    report['HeldStepMarkerCalibrationValid'] = motion_calibrated
    report['InputLatencyCoordinatesValid'] = calibrated or motion_calibrated
    report['InputQueuedToVisibleStepMilliseconds'] = summary(latencies) if calibrated or motion_calibrated else dict(Samples=0)
    report['MissedOrUncalibratedSteps'] = missed
    report['StepObservations'] = observations
print(json.dumps(report, indent=2))
if not valid or (args.pattern == 'steps' and (not report['InputLatencyCoordinatesValid'] or missed)):
    raise SystemExit(1)
