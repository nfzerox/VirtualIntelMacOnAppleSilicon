#!/bin/bash
# Finite real-desktop observation, on the guest OR physical Intel reference.
# Run with sudo; input is posted as that invoking user, not as a root GUI app.
# READY and input must be coordinated here, not across slow tool/SSH round trips.
# No compositor patch, pixel capture, second QMP owner or production polling.
set -euo pipefail
if [[ ( $# != 4 && $# != 5 ) || $(id -u) != 0 || -z ${SUDO_USER:-} ]]; then
    echo 'Use sudo trace-opengl-compositor-phases PID PROBE.d INPUT_EXECUTABLE NEW_ABSOLUTE_LOG_PREFIX [launchpad]' >&2
    exit 2
fi
task_target=$1
task_probe=$2
task_input=$3
task_prefix=$4
task_workload=${5:-compositor}
[[ "$task_workload" == compositor || "$task_workload" == launchpad ]] || exit 2
[[ "$task_target" =~ ^[1-9][0-9]*$ && -r "$task_probe" && -x "$task_input" && "$task_prefix" == /* ]] || exit 2
if [[ ${task_probe##*/} == opengl-compositor-deadlines.d ]]; then
    task_coregraphics=/System/Library/Frameworks/ApplicationServices.framework/Frameworks/CoreGraphics.framework/Versions/A/CoreGraphics
    task_uuid=$(/usr/bin/otool -arch x86_64 -l "$task_coregraphics" |
        /usr/bin/awk '/LC_UUID/{found=1} found && /uuid/{print $2;exit}')
    [[ "$task_uuid" == ED5E3C37-7E2F-3885-8091-DFC9B44B38E8 ]] || {
        echo 'Refused unmatched CoreGraphics deadline layout; no trace/input started.' >&2;exit 2;
    }
fi
if [[ ( ${task_probe##*/} == opengl-compositor-unlock-waits.d ||
         ${task_probe##*/} == opengl-compositor-trap-lock.d ||
         ${task_probe##*/} == opengl-compositor-backing-sleeps.d ||
         ${task_probe##*/} == opengl-compositor-kernel-registers.d ) &&
      $(/usr/sbin/sysctl -n kern.uuid) != 8926E512-6714-34FC-B27C-6AE90EB51D5E ]]; then
    echo 'This read-only mutex layout probe requires the exact qualified guest kernel UUID; no trace/input started.' >&2
    exit 2
fi
for task_suffix in phases.log input.log stderr.log; do
    [[ ! -e "$task_prefix.$task_suffix" ]] || { echo 'Refusing to overwrite an earlier receipt.' >&2; exit 2; }
done
task_trace_pid=
cleanup() {
    if [[ -n "$task_trace_pid" ]] && kill -0 "$task_trace_pid" 2>/dev/null; then
        kill -INT "$task_trace_pid" 2>/dev/null || true
        wait "$task_trace_pid" 2>/dev/null || true
    fi
}
trap cleanup EXIT
/usr/sbin/dtrace -Z -q -s "$task_probe" -p "$task_target" -o "$task_prefix.phases.log" 2>"$task_prefix.stderr.log" &
task_trace_pid=$!
task_ready=0
# This bounded startup barrier is diagnostic-only. Mavericks has no stock rg.
for ((task_attempt=0; task_attempt<600; task_attempt++)); do
    if [[ -r "$task_prefix.phases.log" ]] && /usr/bin/grep -q '^READY compositor ' "$task_prefix.phases.log"; then
        task_ready=1; break
    fi
    kill -0 "$task_trace_pid" 2>/dev/null || { wait "$task_trace_pid"; exit 1; }
    sleep 0.05
done
[[ "$task_ready" == 1 ]] || { echo 'The finite trace did not become ready; no input was posted.' >&2; exit 1; }
{
    if [[ "$task_workload" == launchpad ]]; then
        /usr/bin/sudo -u "$SUDO_USER" "$task_input" launchpad
    else
        /usr/bin/sudo -u "$SUDO_USER" "$task_input" mission-control
        /usr/bin/sudo -u "$SUDO_USER" "$task_input" app-expose
    fi
} >"$task_prefix.input.log" 2>&1
wait "$task_trace_pid"
task_trace_pid=
/usr/bin/grep -q '^END compositor ' "$task_prefix.phases.log"
echo "Completed finite real-input phase receipt: $task_prefix"
