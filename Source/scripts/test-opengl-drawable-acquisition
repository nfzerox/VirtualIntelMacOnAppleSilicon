#!/bin/zsh
set -euo pipefail
root=${0:A:h:h}
mkdir -p "$root/Build/Probes"
xcrun clang -fobjc-arc -fmodules -O2 -g -Wall -Werror -Wno-deprecated-declarations \
    -mmacosx-version-min=15.0 -arch x86_64 -arch arm64 -I "$root/VirtualIntelMac" \
    -framework Cocoa -framework Metal -framework QuartzCore -framework IOSurface \
    -framework ApplicationServices -framework IOKit \
    "$root/probes/opengl-drawable-acquisition.m" "$root/VirtualIntelMac/VIMMetalView.m" \
    -o "$root/Build/Probes/opengl-drawable-acquisition"
exec "$root/Build/Probes/opengl-drawable-acquisition"
