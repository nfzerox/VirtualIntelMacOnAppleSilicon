#!/usr/bin/env python3
"""Exercise production setup objects without starting a VM or changing host settings."""
import argparse
from pathlib import Path
import platform
import subprocess
import tempfile

parser=argparse.ArgumentParser(description=__doc__)
parser.add_argument('--derived-data', required=True, type=Path)
parser.add_argument('--configuration', default='Debug', choices=('Debug','Release'))
args=parser.parse_args()
source=Path(__file__).resolve().parents[1]
objects=args.derived_data/'Build/Intermediates.noindex/VirtualIntelMac.build'/args.configuration/'Virtual Intel Mac.build/Objects-normal'/platform.machine()
inputs=sorted(str(p) for p in objects.glob('*.o') if p.name!='main.o')
assert inputs, 'Build the app before running its setup integration tests'
with tempfile.TemporaryDirectory(prefix='vim-regional-model-') as directory:
    executable=Path(directory)/'regional-settings-tests'
    subprocess.run(['xcrun','clang','-fobjc-arc','-fmodules','-framework','Cocoa','-lbsm','-I',str(source/'VirtualIntelMac'),
                    str(source/'probes/regional-settings-tests.m'),*inputs,'-o',str(executable)],check=True)
    subprocess.run([str(executable)],check=True)
    subprocess.run([str(executable),'-AppleLanguages','(fr-CA,de-CH)','-AppleLocale','en_IN'],check=True)
