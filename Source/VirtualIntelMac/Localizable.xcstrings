    "session.please-do-not-interact-with-macos-utilities-or-the-installer" : {
      "comment" : "VIMSession.m: Please do not interact with macOS Utilities or the installer. The macOS installer is running in the background, and the macOS Utilities window may stay visible meanwhile.\n\nYour virtual Mac will restart several times on its own. Installation may take up to 2 hours.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please do not interact with macOS Utilities or the installer. The macOS installer is running in the background, and the macOS Utilities window may stay visible meanwhile.\n\nYour virtual Mac will restart several times on its own. Installation may take up to 2 hours."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请勿操作“macOS 实用工具”或安装器。macOS 安装器正在后台运行，期间“macOS 实用工具”窗口可能会保持显示。\n\n虚拟 Intel Mac 将自行重启数次。安装可能需要长达 2 小时。"
          }
        }
      }
    },
