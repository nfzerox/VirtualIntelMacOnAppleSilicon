    "session.save-your-work-first-we-ll-check-the-previous-installation" : {
      "comment" : "VIMSession.m: Save your work first. We’ll check the previous installation, retain its recovery records, and prepare fresh graphics support for this macOS build. Keep this Mac running until repair finishes, then restart it. An unfinished or uncertain installation will not be replaced.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save your work first. We’ll check the previous installation, retain its recovery records, and prepare fresh graphics support for this macOS build. Keep this Mac running until repair finishes, then restart it. An unfinished or uncertain installation will not be replaced."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先保存工作。我们将检查上一次安装、保留恢复记录，并为此 macOS 构建准备新的图形支持。请保持此虚拟 Intel Mac 运行，直到修复完成，然后重启。不会重复未完成或结果不确定的安装。"
          }
        }
      }
    },
    "session.save-your-work-in-this-mac-first-virtual-intel-mac" : {
      "comment" : "VIMSession.m: Save your work in this Mac first. Virtual Intel Mac will prepare and install its graphics support. This can take several minutes. Keep this Mac running until setup finishes, then shut it down and open it again.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save your work in this Mac first. Virtual Intel Mac will prepare and install its graphics support. This can take several minutes. Keep this Mac running until setup finishes, then shut it down and open it again."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先保存此虚拟 Intel Mac 中的工作。Virtual Intel Mac 将准备并安装图形支持。这可能需要几分钟。请保持此虚拟 Intel Mac 运行，直到设置完成，然后关机并重新打开。"
          }
        }
      }
    },
