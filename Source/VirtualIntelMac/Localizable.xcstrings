    "session.your-mac-may-restart-several-times-graphics-support-is-installed" : {
      "comment" : "VIMSession.m: \n\nYour Mac may restart several times. Graphics support is installed automatically after setup. Keep this Mac running while setup finishes. Installation may take up to 2 hours.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\nYour Mac may restart several times. Graphics support is installed automatically after setup. Keep this Mac running while setup finishes. Installation may take up to 2 hours."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n\n虚拟 Intel Mac 可能会重启数次。图形支持将在设置后自动安装。请保持此虚拟 Intel Mac 运行，直到设置完成。安装可能需要长达 2 小时。"
          }
        }
      }
    },
    "session.your-network-selection-is-saved-and-will-take-effect-the" : {
