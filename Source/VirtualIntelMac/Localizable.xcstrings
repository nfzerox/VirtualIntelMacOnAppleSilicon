      }
    },
    "session.your-virtual-mac-will-restart-to-finish-installing-the-graphics" : {
      "comment" : "VIMSession.m: Your virtual Mac will restart to finish installing the graphics drivers. Sign in when it starts again. This may take up to 30 minutes.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your virtual Mac will restart to finish installing the graphics drivers. Sign in when it starts again. This may take up to 30 minutes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟 Intel Mac 将重启以完成图形驱动程序安装。重新启动后请登录。此过程可能需要长达 30 分钟。"
          }
        }
      }
    },
    "settings.1-in-the-virtual-mac-open-system-preferences-sharing-and" : {
      "comment" : "VIMMachineSettings.m: 1. In the virtual Mac, open System Preferences → Sharing and turn on File Sharing. In Options, enable SMB for your account.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. In the virtual Mac, open System Preferences → Sharing and turn on File Sharing. In Options, enable SMB for your account."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 在虚拟 Intel Mac 中，打开“系统偏好设置”→“共享”，然后打开“文件共享”。在“选项”中，为你的账户启用 SMB。"
          }
        }
      }
    },
    "settings.1-in-the-virtual-mac-open-system-preferences-sharing-and-2" : {
      "comment" : "VIMMachineSettings.m: 1. In the virtual Mac, open System Preferences → Sharing and turn on Remote Login.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. In the virtual Mac, open System Preferences → Sharing and turn on Remote Login."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 在虚拟 Intel Mac 中，打开“系统偏好设置”→“共享”，然后打开“远程登录”。"
          }
        }
      }
    },
    "settings.1-on-this-mac-go-to-system-settings-general-sharing" : {
      "comment" : "VIMMachineSettings.m: 1. On this Mac, go to System Settings → General → Sharing. Click the info button next to File Sharing and turn it on. Click Options, turn on SMB sharing, then select your account under Windows File Sharing and enter its password.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. On this Mac, go to System Settings → General → Sharing. Click the info button next to File Sharing and turn it on. Click Options, turn on SMB sharing, then select your account under Windows File Sharing and enter its password."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. 在此 Mac 上，前往“系统设置”→“通用”→“共享”。点击“文件共享”旁的信息按钮并将其打开。点击“选项”，打开 SMB 共享，然后在“Windows 文件共享”下选中你的账户并输入密码。"
          }
