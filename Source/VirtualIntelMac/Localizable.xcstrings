    "app.the-app-will-stay-open-so-you-can-check-the" : {
      "comment" : "AppDelegate.m: The app will stay open so you can check the virtual Mac’s window. If guest tools are unavailable, choose Shut Down from its Apple menu. Use Force Stop only if it is unresponsive.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app will stay open so you can check the virtual Mac’s window. If guest tools are unavailable, choose Shut Down from its Apple menu. Use Force Stop only if it is unresponsive."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "应用将保持打开，以便你查看虚拟 Intel Mac 的窗口。如果客户机工具不可用，请从虚拟 Intel Mac 的苹果菜单中选择“关机”。仅在虚拟 Intel Mac 无响应时使用“强制停止”。"
          }
        }
      }
    },
