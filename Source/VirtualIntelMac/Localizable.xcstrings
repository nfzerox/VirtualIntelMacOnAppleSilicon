            "value" : "Your network selection is saved and will take effect the next time this virtual Mac starts. Its current connection stays active until then."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "网络选择已保存，将在下次启动此虚拟 Intel Mac 时生效。在此之前，当前连接将保持启用。"
          }
        }
      }
    },
