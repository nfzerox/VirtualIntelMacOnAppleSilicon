          }
        }
      }
    },
    "session.your-virtual-mac-will-restart-automatically-when-it-s-ready" : {
      "comment" : "VIMSession.m: Your virtual Mac will restart automatically when it’s ready. If you see the login screen, sign in with the account you chose.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
