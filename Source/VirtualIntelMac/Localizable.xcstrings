          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virtual Intel Mac 需要在此 Apple 芯片 Mac 上原生运行。请退出应用，在访达中选中它，然后选择“文件”→“显示简介”。关闭“使用 Rosetta 打开”，再重新打开应用。"
          }
