  "strings" : {
    "regional.defaults-unsaved": {
      "comment": "An invalid edit was not saved; the last valid new-machine policy remains active.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not saved: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未保存：%@"
          }
        }
      }
    },
    "regional.defaults-inline-help": {
      "comment": "Inline regional defaults in the application Advanced settings page.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires Automatic Setup."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要启用自动设置。"
          }
        }
      }
    },
    "regional.defaults-invalid": {
      "comment": "Default regional policy for future virtual Macs; experimental and explicitly enabled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read the default language and region settings. Check Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取默认语言与地区，请在软件设置中检查。"
          }
        }
      }
    },
    "regional.creation-inactive": {
      "comment": "Default regional policy for future virtual Macs; experimental and explicitly enabled.",
      "extractionState": "manual",
      "localizations": {
