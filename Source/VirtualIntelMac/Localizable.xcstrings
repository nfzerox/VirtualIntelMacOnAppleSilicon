    "session.its-disks-must-first-be-unmounted-from-this-mac-save" : {
      "comment" : "VIMSession.m: Its disks must first be unmounted from this Mac. Save your work on this device before continuing. They’ll be available to the virtual Mac instead.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its disks must first be unmounted from this Mac. Save your work on this device before continuing. They’ll be available to the virtual Mac instead."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必须先从此 Mac 卸载其磁盘。继续前，请保存此设备上的工作。随后这些磁盘将由虚拟 Intel Mac 使用。"
          }
        }
      }
    },
    "session.its-saved-selection-couldn-t-be-cleared-you-can-still" : {
      "comment" : "VIMSession.m: Its saved selection couldn’t be cleared. You can still disconnect it from CD/DVD or choose it again when its drive is available.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its saved selection couldn’t be cleared. You can still disconnect it from CD/DVD or choose it again when its drive is available."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法清除此映像已保存的选择。你仍可从 CD/DVD 中断开它，或在其驱动器可用后重新选择。"
          }
        }
      }
    },
    "session.keep-it-running-in-the-background-or-shut-down-macos" : {
      "comment" : "VIMSession.m: Keep it running in the background, or shut down macOS. Save your work inside this Mac before shutting down. You can return to it from the library.",
