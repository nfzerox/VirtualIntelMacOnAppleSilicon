      }
    },
    "session.your-virtual-mac-will-restart-and-sign-in-automatically-when" : {
      "comment" : "VIMSession.m: Your virtual Mac will restart and sign in automatically when it’s ready.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
