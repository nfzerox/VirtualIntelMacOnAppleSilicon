    "creation.installing-mac-os-x-requires-downloading-the-installer-from-the" : {
      "comment" : "VIMNewMachineWindow.m: Installing Mac OS X %@ requires downloading the installer from the Internet Archive, which is not available in your region. Download %@ using a connection where the Internet Archive is available, then choose Use Existing Installer.\n\nYou can also install Mac OS X Lion 10.7 or later instead, which are directly downloaded from Apple and does not require access to the Internet Archive.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installing Mac OS X %@ requires downloading the installer from the Internet Archive, which is not available in your region. Download %@ using a connection where the Internet Archive is available, then choose Use Existing Installer.\n\nYou can also install Mac OS X Lion 10.7 or later instead, which are directly downloaded from Apple and does not require access to the Internet Archive."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装 Mac OS X %@ 需要从互联网档案馆下载安装器，但你所在的地区无法访问。请使用可访问互联网档案馆的网络下载 %@，然后选择“使用现有安装器”。\n\n你也可以改为安装 Mac OS X Lion 10.7 或更新版本，它们直接从 Apple 下载，无需访问互联网档案馆。"
          }
        }
      }
    },
