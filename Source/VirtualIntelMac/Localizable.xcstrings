    "session.close-apps-using-the-image-and-eject-it-in-the" : {
      "comment" : "VIMSession.m: Close apps using the image and eject it in the virtual Mac’s Finder, then try again. If it still can’t be ejected, shut down the virtual Mac before disconnecting it. Forcing a mounted image to disconnect can leave macOS waiting for a disk that is no longer available.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close apps using the image and eject it in the virtual Mac’s Finder, then try again. If it still can’t be ejected, shut down the virtual Mac before disconnecting it. Forcing a mounted image to disconnect can leave macOS waiting for a disk that is no longer available."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请关闭使用映像的应用，并在虚拟 Intel Mac 的访达中推出它，然后重试。如果仍无法推出，请先关闭虚拟 Intel Mac 再断开连接。强制断开已挂载的映像可能导致 macOS 一直等待已不可用的磁盘。"
          }
        }
      }
    },
    "session.close-apps-using-this-device-and-try-again-or-force" : {
      "comment" : "VIMSession.m: Close apps using this device and try again, or force unmount it to connect it to the virtual Mac. Forcing an unmount can lose unsaved changes on the device.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close apps using this device and try again, or force unmount it to connect it to the virtual Mac. Forcing an unmount can lose unsaved changes on the device."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请关闭使用此设备的应用后重试，或强制卸载以连接到虚拟 Intel Mac。强制卸载可能丢失设备上未保存的更改。"
          }
        }
      }
    },
