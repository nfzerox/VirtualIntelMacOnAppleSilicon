    "discimage.this-image-uses-a-disk-format-or-compression-method-that" : {
      "comment" : "VIMDiscImage.m: This image uses a disk format or compression method that Virtual Intel Mac can’t read. Choose an ISO, CDR or Toast image, or a DMG that is uncompressed or uses zlib, bzip2 or LZFSE compression. No conversion was attempted, and your original image hasn’t been changed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This image uses a disk format or compression method that Virtual Intel Mac can’t read. Choose an ISO, CDR or Toast image, or a DMG that is uncompressed or uses zlib, bzip2 or LZFSE compression. No conversion was attempted, and your original image hasn’t been changed."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此映像使用了 Virtual Intel Mac 无法读取的磁盘格式或压缩方式。请选择 ISO、CDR、Toast 映像，或未压缩、使用 zlib、bzip2 或 LZFSE 压缩的 DMG。"
          }
        }
