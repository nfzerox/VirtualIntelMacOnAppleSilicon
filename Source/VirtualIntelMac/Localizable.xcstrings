    "app.running-save-your-work-in-each-virtual-mac-before-shutting" : {
      "comment" : "AppDelegate.m: Running: %@\n\nSave your work in each virtual Mac before shutting down. Force Stop stops immediately without letting macOS finish.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Running: %@\n\nSave your work in each virtual Mac before shutting down. Force Stop stops immediately without letting macOS finish."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在运行：%@\n\n关闭前，请保存各虚拟 Intel Mac 中的工作。“强制停止”会立即停止虚拟 Intel Mac，不会等待 macOS 完成关机。"
          }
        }
      }
    },
