    "regional.automatic-required-detail": {
      "comment": "Default regional policy for future virtual Macs; experimental and explicitly enabled.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Automatic Setup to set the language, region and time zone, or skip these settings for this Mac."
