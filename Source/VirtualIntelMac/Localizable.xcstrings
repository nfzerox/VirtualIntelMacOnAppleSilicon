    "app.keep-the-finished-installer-app-and-disk-image-for-another" : {
      "comment" : "AppDelegate.m: Keep the finished installer app and disk image for another virtual Mac. Temporary preparation files are always removed. Otherwise, the installer image is removed after the operating system is installed and graphics support is verified.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep the finished installer app and disk image for another virtual Mac. Temporary preparation files are always removed. Otherwise, the installer image is removed after the operating system is installed and graphics support is verified."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留准备完成的安装器应用和磁盘映像，以便用于其他虚拟 Intel Mac。准备过程中的临时文件始终会被清理。如果关闭此选项，安装映像将在操作系统安装完成且图形加速验证通过后移除。"
          }
        }
      }
    },
