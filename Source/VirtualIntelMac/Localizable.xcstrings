    "session.your-virtual-mac-will-install-the-operating-system-and-create" : {
      "comment" : "VIMSession.m: Your virtual Mac will install the operating system and create your account automatically. You don’t need to erase the disk or choose Reinstall.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your virtual Mac will install the operating system and create your account automatically. You don’t need to erase the disk or choose Reinstall."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虚拟 Intel Mac 将自动安装操作系统并创建账户。你无需抹掉磁盘或选择“重新安装”。"
          }
        }
      }
    },
    "session.your-virtual-mac-will-restart-and-sign-in-automatically-this" : {
      "comment" : "VIMSession.m: Your virtual Mac will restart and sign in automatically this first time.",
      "extractionState" : "manual",
