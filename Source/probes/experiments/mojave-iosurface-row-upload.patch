+/* A complete input-only IOSurface import uses the existing prepared upload
+ * contract, then consumes its normal result before releasing CPU ownership.
+ * Pitch gaps are not sent. The native import, format rules and texture/FBO
+ * lifetime stay exactly the same as the copied command. */
+static int DGImportIOSurfaceRows(unsigned internal,unsigned format,unsigned type,int width,int height,
+    const void *pixels,size_t stride,unsigned element_bytes,int packed)
+{
+    uint64_t row=(uint64_t)width*element_bytes,bytes=row*height;
+    if(bytes>DG_MAX_BYTES || row>UINT32_MAX)return -1;
+    // Keep the copied packet's cache/error-witness invalidation too.
+    struct DGPacket packet=DGPacketNew(dg_current,packed?DG_IOSURFACE_TEXTURE_PACKED:DG_IOSURFACE_TEXTURE);
+    struct DGMessage command=packet.message;
+    command.flags=DG_REPLY|DG_INPUT_ONLY;command.bytes=(uint32_t)bytes;
+    command.args[0]=internal;command.args[1]=width;command.args[2]=height;command.args[3]=row;
+    if(packed){command.args[6]=format;command.args[7]=type;}
+    return DGUploadMessageRows(dg_current,&command,pixels,(unsigned)row,(unsigned)height,stride,0);
 }
