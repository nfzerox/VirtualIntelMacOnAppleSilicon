+/* Preserve the initiator's DER MechTypeList, excluding its outer [0] tag.
+ * The normal mechanism parser has already validated this initial token.
+ * RFC4178 section5 signs this exact sequence, NOT the NTLM response token. */
+BOOL spnego_mech_list_blob(DATA_BLOB blob, DATA_BLOB *list)
+{
+	ASN1_DATA data;
+	int start, length;
+	*list = data_blob(NULL, 0);
+	asn1_load(&data, blob);
+	asn1_start_tag(&data, ASN1_APPLICATION(0));
+	asn1_check_OID(&data, OID_SPNEGO);
+	asn1_start_tag(&data, ASN1_CONTEXT(0));
+	asn1_start_tag(&data, ASN1_SEQUENCE(0));
+	asn1_start_tag(&data, ASN1_CONTEXT(0));
+	start = data.ofs;
+	asn1_start_tag(&data, ASN1_SEQUENCE(0));
+	length = data.ofs - start + asn1_tag_remaining(&data);
+	if (!data.has_error && start >= 0 && length > 2 &&
+	    start <= data.length && length <= data.length - start) {
+		*list = data_blob(data.data + start, length);
+	}
+	asn1_free(&data);
+	return list->data != NULL;
 }
 
+/* NTLM's optional SPNEGO MIC is not ignorable authentication padding.
+ * Keep the old public parser unchanged for its other callers. This entry
+ * requires a nonempty mechanism token and a complete16-byte NTLM MIC if one
+ * is present; unknown/duplicate/trailing fields are never silently stripped. */
+BOOL spnego_parse_ntlm_auth_mic(DATA_BLOB blob, DATA_BLOB *auth, DATA_BLOB *mic)
+{
+	ASN1_DATA data;
+	*auth = data_blob(NULL, 0);
+	*mic = data_blob(NULL, 0);
+	asn1_load(&data, blob);
+	asn1_start_tag(&data, ASN1_CONTEXT(1));
+	asn1_start_tag(&data, ASN1_SEQUENCE(0));
+	asn1_start_tag(&data, ASN1_CONTEXT(2));
+	asn1_read_OctetString(&data, auth);
+	asn1_end_tag(&data);
+	if (!data.has_error && asn1_tag_remaining(&data) > 0) {
+		asn1_start_tag(&data, ASN1_CONTEXT(3));
+		asn1_read_OctetString(&data, mic);
+		asn1_end_tag(&data);
+		if (mic->length != 16) data.has_error = True;
+	}
+	asn1_end_tag(&data);
+	asn1_end_tag(&data);
+	if (data.has_error || data.ofs != data.length || !auth->length) {
+		data_blob_free(auth);
+		data_blob_free(mic);
+		asn1_free(&data);
+		return False;
+	}
+	asn1_free(&data);
+	return True;
+}
