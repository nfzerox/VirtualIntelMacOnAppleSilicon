+/* Darwin9's Local node verifies NTLMv2 but does not implement the Password
+ * Server's key-retrieval API. Use ONLY its already-opted-in native SMB-NT
+ * credential, inside the root authentication server, after native password
+ * verification. No password/hash is copied to a new database or exported. */
+static tDirStatus local_ntlmv2_session_key(struct opendirectory_session *session,
+	tDirNodeReference node, const char *recordName, const char *domain,
+	const unsigned char *response, unsigned responseLength, unsigned char key[16])
+{
+	tDirStatus status=eDSAuthFailed;
+	tRecordReference record=0;
+	tDataNodePtr type=NULL,name=NULL,attribute=NULL;
+	tAttributeValueEntryPtr value=NULL;
+	tAttributeEntryPtr info=NULL;
+	char guid[37]={0},path[128],hex[32];
+	unsigned char hash[16]={0},v2[16]={0};
+	struct stat st;
