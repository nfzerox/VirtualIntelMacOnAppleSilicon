+	type=dsDataNodeAllocateString(session->ref,kDSStdRecordTypeUsers);
+	name=dsDataNodeAllocateString(session->ref,recordName);
+	if (!type || !name || dsOpenRecord(node,type,name,&record)!=eDSNoErr) goto done;
+	attribute=dsDataNodeAllocateString(session->ref,kDS1AttrGeneratedUID);
+	if (!attribute || dsGetRecordAttributeValueByIndex(record,attribute,1,&value)!=eDSNoErr ||
+	    !value || value->fAttributeValueData.fBufferLength!=36) goto done;
+	memcpy(guid,value->fAttributeValueData.fBufferData,36);
+	for (i=0;i<36;i++) {
+		if (i==8 || i==13 || i==18 || i==23) {if(guid[i]!='-') goto done;}
+		else if (!((guid[i]>='0'&&guid[i]<='9') || (guid[i]>='A'&&guid[i]<='F') ||
+		           (guid[i]>='a'&&guid[i]<='f'))) goto done;
+	}
+	dsDeallocAttributeValueEntry(session->ref,value);value=NULL;
+	opendirectory_free_node(session,attribute);attribute=NULL;
+	attribute=dsDataNodeAllocateString(session->ref,kDSNAttrAuthenticationAuthority);
+	if (!attribute || dsGetRecordAttributeInfo(record,attribute,&info)!=eDSNoErr ||
+	    !info || info->fAttributeValueCount>16) goto done;
+	for (i=1;i<=info->fAttributeValueCount;i++) {
+		char authority[1024];unsigned n;
+		if (dsGetRecordAttributeValueByIndex(record,attribute,i,&value)!=eDSNoErr || !value) goto done;
+		n=value->fAttributeValueData.fBufferLength;
+		if (n>=sizeof(authority)) goto done;
+		memcpy(authority,value->fAttributeValueData.fBufferData,n);authority[n]=0;
+		if (strncmp(authority,";ShadowHash;HASHLIST:<",strlen(";ShadowHash;HASHLIST:<"))==0 &&
+		    (strstr(authority,"<SMB-NT,") || strstr(authority,",SMB-NT,") ||
+		     strstr(authority,"<SMB-NT>") || strstr(authority,",SMB-NT>"))) optedIn=True;
+		dsDeallocAttributeValueEntry(session->ref,value);value=NULL;
+	}
+	if (!optedIn) goto done;
+	/* Fixed root-owned parents and a validated GUID, never a client path.
+	 * Reject links, permissive credentials and unexpected data formats. */
+	if (lstat("/private/var/db/shadow",&st)!=0 || !S_ISDIR(st.st_mode) || st.st_uid || (st.st_mode&022)) goto done;
+	if (lstat("/private/var/db/shadow/hash",&st)!=0 || !S_ISDIR(st.st_mode) || st.st_uid || (st.st_mode&077)) goto done;
+	snprintf(path,sizeof(path),"/private/var/db/shadow/hash/%s",guid);
+	fd=open(path,O_RDONLY|O_NOFOLLOW);
+	if (fd<0 || fstat(fd,&st)!=0 || !S_ISREG(st.st_mode) || st.st_uid ||
