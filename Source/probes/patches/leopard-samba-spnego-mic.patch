+	{ volatile unsigned char *p;size_t n;
+	  for(p=hash,n=sizeof(hash);n--;)*p++=0;
+	  for(p=v2,n=sizeof(v2);n--;)*p++=0;
+	  for(p=(unsigned char *)hex,n=sizeof(hex);n--;)*p++=0; }
 	return status;
 }
 
